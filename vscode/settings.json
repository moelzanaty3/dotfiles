{
  "editor.fontFamily": "Dank Mono",
  "editor.fontLigatures": true,
  "editor.inlineSuggest.enabled": true,
  "editor.fontSize": 18,
  "editor.fontWeight": "700",
  "editor.quickSuggestions": {
    "strings": true,
  },
  "git.autofetch": true,
  "[js/ts]": {
    "updateImportsOnFileMove.enabled": "always",
  },
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1",
    "Q_NEW_SESSION": "1",
  },
  "terminal.integrated.fontSize": 16,
  "errorLens.enabledDiagnosticLevels": ["info", "error"],
  "errorLens.statusBarIconsEnabled": true,
  "errorLens.editorHoverPartsEnabled": {
    "messageEnabled": true,
  },
  "errorLens.statusBarColorsEnabled": true,
  "errorLens.enabled": true,
  "vsintellicode.typescript.completionsEnabled": false,
  "[js/ts]": {
    "suggest.includeAutomaticOptionalChainCompletions": false,
    "suggest.classMemberSnippets.enabled": false,
    "suggest.objectLiteralMethodSnippets.enabled": false,
  },
  "editor.suggest.showSnippets": false,
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "editor.defaultFormatter": "vscode.typescript-language-features",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
    },
    "zsh": {
      "path": "zsh",
    },
    "fish": {
      "path": "fish",
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux",
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell",
    },
  },
  "window.commandCenter": false,
  "editor.tabSize": 2,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.editorActionsLocation": "hidden",
  "search.exclude": {
    ".next": true,
    "**/.build": true,
    "**/.gh-pages": true,
    "**/.next": true,
    "**/bower_components": true,
    "**/build": true,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/.nx": true,
    "**/.turbo": true,
  },
  "[js/ts]": {
    "inlayHints.parameterTypes.enabled": false,
    "inlayHints.propertyDeclarationTypes.enabled": false,
    "inlayHints.variableTypes.enabled": false,
    "inlayHints.functionLikeReturnTypes.enabled": false,
    "inlayHints.parameterNames.suppressWhenArgumentMatchesName": false,
    "inlayHints.parameterNames.enabled": "all",
    "inlayHints.variableTypes.suppressWhenTypeMatchesName": false,
  },
  "editor.minimap.enabled": false,
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop",
  ],
  "git.ignoreRebaseWarning": true,
  "githubPullRequests.pushBranch": "always",
  "diffEditor.ignoreTrimWhitespace": false,
  "cursor.chat.showSuggestedFiles": true,
  "editor.accessibilitySupport": "off",
  "redhat.telemetry.enabled": false,
  "[dotenv]": {},
  "files.associations": {
    ".env*": "dotenv",
  },
  "[properties]": {},
  "gitlens.ai.generateCommitMessage.customInstructions": "",
  "[ignore]": {},
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "never",
    "source.fixAll.githubCopilot": "never",
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[shellscript]": {},
  "[python]": {
    "editor.tabSize": 2,
    "editor.formatOnType": true,
  },
  "editor.lineNumbers": "relative",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "window.newWindowProfile": "Default",
  "terminal.integrated.fontLigatures": true,
  "terminal.integrated.fontFamily": "'Hack Nerd Font'",
  "cursor.cmdk.useThemedDiffBackground": true,
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "editor.inlayHints.enabled": "off",
  "gitlens.launchpad.indicator.enabled": false,
  "githubPullRequests.pullBranch": "never",
  "go.toolsManagement.autoUpdate": true,
  "git.confirmSync": false,
  "cursor.composer.shouldAllowCustomModes": true,
  "cursor.terminal.usePreviewBox": true,
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "cursor.cpp.disabledLanguages": ["plaintext", "markdown", "scminput"],
  "workbench.externalBrowser": "arch",
  "vim.relativenumber": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.general.globalCursorIgnoreList": [
    "**/credentials.json",
    "**/credentials.*.json",
    "**/secret.json",
    "**/secrets.json",
    "**/*.key",
    "**/*.pem",
    "**/*.pfx",
    "**/*.p12",
    "**/*.crt",
    "**/*.cer",
    "**/id_rsa",
    "**/id_dsa",
    "**/.ssh/id_*",
  ],
  "[markdown]": {},
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "cursor.windowSwitcher.sidebarHoverCollapsed": true,
  "update.releaseTrack": "prerelease",
  "[java]": {},
  "json.schemaDownload.enable": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
  },
  "[github-actions-workflow]": {},
  "eslint.run": "onSave",
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.next/**": true,
    "**/.nx/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/cypress/**": true,
    "**/playwright-report/**": true,
    "**/tmp/**": true,
  },
  "typescript.tsserver.maxTsServerMemory": 4072,
  "security.promptForLocalFileProtocolHandling": false,
  "window.zoomLevel": 0,
  "workbench.colorTheme": "Github Dark Tritanopia",
  "[js/ts]": {
    "tsdk.path": "node_modules/typescript/lib",
    "tsdk.promptToUseWorkspaceVersion": true,
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "workbench.settings.applyToAllProfiles": [],
  "git.blame.statusBarItem.enabled": false,
  "gitlens.hovers.currentLine.over": "line",
  "json.schemas": [],
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "chat.viewSessions.orientation": "stacked",
  "workbench.iconTheme": "vscode-icons",
  "workbench.sideBar.location": "right",
  "explorer.confirmDragAndDrop": false,
  "claudeCode.preferredLocation": "panel",
  "@azure.argTenant": "",
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.extensionUnification.enabled": false,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.githubMcpServer.readonly": true,
  "gitlens.gitkraken.mcp.autoEnabled": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
}
